<Window x:Class="AzureExamQuestions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Exam Quiz"
        Width="520"
        MinHeight="420" MaxHeight="760"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F2F1"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4">
            <Grid Margin="32,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="My Exam Quiz" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Подготовка к сертификации Microsoft Azure"
                               FontSize="12" Foreground="#BEE0F8" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="История"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#BEE0F8"
                        BorderBrush="#4DA6EB" BorderThickness="1"
                        Padding="10,5" FontSize="12"
                        Click="HistoryButton_Click"/>
            </Grid>
        </Border>

        <!-- Setup card -->
        <Border Grid.Row="1" Background="White" Margin="32,20,32,24"
                CornerRadius="8" Padding="32,24">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.10" Color="Black"/>
            </Border.Effect>

            <!--
                DockPanel: footer (separator + button) docked to Bottom first,
                then the content StackPanel fills the remaining space.
                Button is always visible regardless of how tall the content grows.
            -->
            <DockPanel LastChildFill="True">

                <!-- Footer — pinned to bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Separator Background="#E1DFDD" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="BookmarksOnlyCheck"
                                      Content="Только избранные"
                                      FontSize="13"
                                      Checked="BookmarksOnlyCheck_Changed"
                                      Unchecked="BookmarksOnlyCheck_Changed"/>
                            <TextBlock x:Name="BookmarkCountText"
                                       FontSize="11" Foreground="#8A8886"
                                       Margin="20,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="StartButton" Grid.Column="1" Content="Начать тест"
                                Style="{StaticResource PrimaryButton}"
                                Click="StartButton_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Main controls -->
                <StackPanel>
                    <TextBlock Text="Настройка теста" FontSize="17" FontWeight="SemiBold"
                               Foreground="#323130" Margin="0,0,0,16"/>

                    <!-- Exam selector -->
                    <TextBlock Text="Экзамен:" FontSize="13" Foreground="#323130" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ExamComboBox"
                              FontSize="13" Padding="10,7"
                              SelectionChanged="ExamComboBox_SelectionChanged"/>
                    <TextBlock x:Name="ExamDescText"
                               FontSize="11" Foreground="#8A8886" FontStyle="Italic"
                               Margin="2,4,0,16" TextWrapping="Wrap"/>

                    <Separator Background="#E1DFDD" Margin="0,0,0,16"/>

                    <!-- Mode selection -->
                    <TextBlock Text="Режим:" FontSize="13" Foreground="#323130" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="StudyModeRadio"
                                     Content="Обучение"
                                     FontSize="13" IsChecked="True"
                                     GroupName="QuizMode"
                                     Checked="StudyModeRadio_Checked"
                                     Margin="0,0,16,0"/>
                        <RadioButton x:Name="ExamModeRadio"
                                     Content="Экзамен"
                                     FontSize="13"
                                     GroupName="QuizMode"
                                     Checked="ExamModeRadio_Checked"/>
                    </StackPanel>
                    <TextBlock x:Name="ModeDescText"
                               FontSize="11" Foreground="#8A8886" FontStyle="Italic"
                               Margin="2,2,0,12" TextWrapping="Wrap"
                               Text="Обучение: сразу показывает правильный ответ и объяснение."/>

                    <!-- Timer settings (exam mode only) -->
                    <StackPanel x:Name="TimerPanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Время на вопрос (сек):" FontSize="13" Foreground="#323130"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimerValueText" Grid.Column="1"
                                       FontSize="12" Foreground="#0078D4" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="TimerSlider"
                                    Minimum="30" Maximum="180" Value="90"
                                    TickFrequency="15" IsSnapToTickEnabled="True"
                                    ValueChanged="TimerSlider_ValueChanged"
                                    VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#EFF6FC" CornerRadius="4"
                                    Width="36" Height="36" HorizontalAlignment="Center">
                                <TextBlock x:Name="TimerBadgeText" Text="90"
                                           FontSize="15" FontWeight="Bold" Foreground="#0078D4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,2,44,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="30с" Grid.Column="0" HorizontalAlignment="Left"
                                       FontSize="11" Foreground="#8A8886"/>
                            <TextBlock Text="105с" Grid.Column="1" HorizontalAlignment="Center"
                                       FontSize="11" Foreground="#8A8886"/>
                            <TextBlock Text="180с" Grid.Column="2" HorizontalAlignment="Right"
                                       FontSize="11" Foreground="#8A8886"/>
                        </Grid>
                    </StackPanel>

                    <Separator Background="#E1DFDD" Margin="0,0,0,16"/>

                    <!-- Difficulty -->
                    <TextBlock Text="Минимальный уровень сложности:" FontSize="13" Foreground="#323130"/>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DifficultySlider"
                                Minimum="1" Maximum="5" Value="1"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="DifficultySlider_ValueChanged"
                                VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#EFF6FC" CornerRadius="4"
                                Width="36" Height="36" HorizontalAlignment="Center">
                            <TextBlock x:Name="DifficultyValueText" Text="1"
                                       FontSize="18" FontWeight="Bold" Foreground="#0078D4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,2,44,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1 — легкий" Grid.Column="0" HorizontalAlignment="Left"
                                   FontSize="11" Foreground="#8A8886"/>
                        <TextBlock Text="3" Grid.Column="1" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="#8A8886"/>
                        <TextBlock Text="5 — сложный" Grid.Column="2" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="#8A8886"/>
                    </Grid>

                    <!-- Question count -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Количество вопросов:" FontSize="13" Foreground="#323130"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="AvailableText" Grid.Column="1"
                                   FontSize="12" Foreground="#8A8886" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="CountSlider"
                                Minimum="1" Maximum="120" Value="10"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="CountSlider_ValueChanged"
                                VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#EFF6FC" CornerRadius="4"
                                Width="36" Height="36" HorizontalAlignment="Center">
                            <TextBlock x:Name="CountValueText" Text="10"
                                       FontSize="18" FontWeight="Bold" Foreground="#0078D4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
</Window>
