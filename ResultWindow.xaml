<Window x:Class="AzureExamQuestions.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты теста"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F2F1"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#0078D4">
            <Grid VerticalAlignment="Center" Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Тест завершён!" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="HeaderSubtitle" FontSize="12" Foreground="#BEE0F8" Margin="0,3,0,0"/>
                </StackPanel>
                <!-- Pass/Fail badge (exam mode) -->
                <Border x:Name="PassFailBadge" Grid.Column="1"
                        CornerRadius="6" Padding="14,6"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PassFailText"
                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Card -->
        <Border Grid.Row="1" Background="White" Margin="32,20,32,24"
                CornerRadius="8" Padding="32,24">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.10" Color="Black"/>
            </Border.Effect>

            <StackPanel>

                <!-- Score circle -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse x:Name="ScoreCircle" Width="96" Height="96" Fill="#EFF6FC"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText"
                                   FontSize="26" FontWeight="Bold" Foreground="#0078D4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreLabel" Text="результат"
                                   FontSize="11" Foreground="#8A8886"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Stats rows -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Всего вопросов:" FontSize="14" Foreground="#605E5C"/>
                    <TextBlock x:Name="TotalText" Grid.Column="1"
                               FontSize="14" FontWeight="SemiBold" Foreground="#323130"/>
                </Grid>

                <Separator Background="#F3F2F1" Margin="0,4"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓  Правильных:" FontSize="14" Foreground="#107C10"/>
                    <TextBlock x:Name="CorrectText" Grid.Column="1"
                               FontSize="14" FontWeight="Bold" Foreground="#107C10"/>
                </Grid>

                <Separator Background="#F3F2F1" Margin="0,4"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✗  Неправильных:" FontSize="14" Foreground="#A4262C"/>
                    <TextBlock x:Name="WrongText" Grid.Column="1"
                               FontSize="14" FontWeight="Bold" Foreground="#A4262C"/>
                </Grid>

                <Separator Background="#F3F2F1" Margin="0,4"/>

                <!-- Score 0-1000 (exam mode) -->
                <Grid x:Name="ExamScoreRow" Margin="0,8,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Оценка (0–1000):" FontSize="14" Foreground="#605E5C"/>
                    <TextBlock x:Name="ExamScoreText" Grid.Column="1"
                               FontSize="14" FontWeight="Bold" Foreground="#323130"/>
                </Grid>

                <!-- Time spent -->
                <Grid x:Name="TimeRow" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⏱  Время:" FontSize="14" Foreground="#605E5C"/>
                    <TextBlock x:Name="TimeText" Grid.Column="1"
                               FontSize="14" FontWeight="SemiBold" Foreground="#323130"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Пройти снова"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,10"
                                Click="RestartButton_Click"/>
                        <Button Grid.Column="2" Content="Выйти"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,10"
                                Click="ExitButton_Click"/>
                    </Grid>
                    <Button x:Name="ReviewButton"
                            Content="Разбор ошибок →"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,10" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"
                            Click="ReviewButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
