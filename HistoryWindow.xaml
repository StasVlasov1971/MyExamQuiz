<Window x:Class="AzureExamQuestions.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История тестов"
        Width="680" Height="540"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#0078D4" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="История тестов" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#B3D9F7" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Очистить историю"
                        Background="Transparent" Foreground="#B3D9F7"
                        BorderBrush="#4DA6EB" BorderThickness="1"
                        Padding="10,5" FontSize="12"
                        Click="ClearButton_Click"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="20,12">
            <Button Content="Закрыть"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Width="100"
                    Click="CloseButton_Click"/>
        </Border>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText"
                   Text="Нет завершённых тестов. Пройдите первый тест — он появится здесь."
                   FontSize="14" Foreground="#9CA3AF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="40" Visibility="Collapsed"/>

        <!-- List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6"
                                Margin="0,0,0,8" Padding="16,12"
                                BorderBrush="#E5E7EB" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <!-- Exam + mode -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ExamTitle}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#1A1A2E"/>
                                        <Border Background="#EFF6FC" CornerRadius="3"
                                                Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Mode}"
                                                       FontSize="11" Foreground="#0078D4"/>
                                        </Border>
                                        <!-- Pass/Fail badge (exam mode) -->
                                        <Border x:Name="PassBadge"
                                                Background="{Binding PassBadgeColor}"
                                                CornerRadius="3" Padding="6,2" Margin="6,0,0,0"
                                                Visibility="{Binding PassBadgeVisibility}">
                                            <TextBlock Text="{Binding PassBadgeText}"
                                                       FontSize="11" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- Date + time -->
                                    <TextBlock Text="{Binding DateFormatted}"
                                               FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Score on the right -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScoreDisplay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding ScoreColor}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding StatsLine}"
                                               FontSize="11" Foreground="#6B7280"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
