<Window x:Class="AzureExamQuestions.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разбор ошибок"
        Width="760" Height="620"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="OptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#0078D4" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Разбор ошибок"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="SubtitleText"
                           FontSize="13" Foreground="#B3D9F7"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Пройти снова"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}"
                        Width="130"
                        Click="RetryButton_Click"/>
                <Button Content="Закрыть"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl x:Name="ErrorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Each wrong answer card -->
                        <Border Background="White" CornerRadius="8"
                                Margin="0,0,0,12"
                                Padding="16"
                                BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <!-- Question number + difficulty -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Stars}"
                                               FontSize="12" Foreground="#F59E0B"
                                               Margin="8,0,0,0"/>
                                </StackPanel>

                                <!-- Question text -->
                                <TextBlock Text="{Binding QuestionText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1A1A2E"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <!-- Your answer -->
                                <Border Background="#FEF2F2" CornerRadius="4"
                                        Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Ваш ответ:" Style="{StaticResource SectionHeader}"
                                                   Foreground="#DC2626"/>
                                        <TextBlock Text="{Binding UserAnswerText}"
                                                   Style="{StaticResource OptionText}"
                                                   Foreground="#7F1D1D"/>
                                    </StackPanel>
                                </Border>

                                <!-- Correct answer -->
                                <Border Background="#F0FDF4" CornerRadius="4"
                                        Padding="10,8" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Правильный ответ:" Style="{StaticResource SectionHeader}"
                                                   Foreground="#16A34A"/>
                                        <TextBlock Text="{Binding CorrectAnswerText}"
                                                   Style="{StaticResource OptionText}"
                                                   Foreground="#14532D"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
