<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AzureExamQuestions</RootNamespace>
    <AssemblyName>MyExamQuiz</AssemblyName>
  </PropertyGroup>

  <!-- Вопросы и пользовательские данные в выходной каталог не копируются:
       пути к ним задаются в appsettings.json. -->
</Project>
