<Window x:Class="AzureExamQuestions.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Exam Quiz"
        Width="740" Height="660"
        MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F3F2F1"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#0078D4" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QuestionNumberText"
                           FontSize="15" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="DifficultyText" Grid.Column="1"
                           FontSize="18" Foreground="#BEE0F8"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <!-- Bookmark button -->
                <Button x:Name="BookmarkButton" Grid.Column="2"
                        FontSize="18" Background="Transparent"
                        BorderThickness="0" Foreground="#BEE0F8"
                        VerticalAlignment="Center" Margin="12,0,0,0"
                        ToolTip="Добавить в избранное"
                        Click="BookmarkButton_Click">☆</Button>
                <!-- Timer (exam mode only) -->
                <Border x:Name="TimerBorder" Grid.Column="3"
                        Background="#1A5FA8" CornerRadius="4"
                        Padding="10,4" Margin="16,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TimerText"
                               FontSize="15" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Tri-color progress bar: green=correct, red=wrong, blue=remaining -->
        <Grid Grid.Row="1" Height="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColCorrect" Width="0*"/>
                <ColumnDefinition x:Name="ColWrong"   Width="0*"/>
                <ColumnDefinition x:Name="ColRemain"  Width="1*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#107C10"/>
            <Rectangle Grid.Column="1" Fill="#A4262C"/>
            <Rectangle Grid.Column="2" Fill="#4DA6EB"/>
        </Grid>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
            <StackPanel>

                <!-- Question text card -->
                <Border Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <TextBlock x:Name="QuestionText"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="#323130" LineHeight="22"/>
                </Border>

                <!-- Multi-answer hint -->
                <TextBlock x:Name="MultiAnswerHint"
                           Text="Выберите все правильные ответы:"
                           FontSize="12" FontStyle="Italic" Foreground="#8A8886"
                           Margin="2,0,0,6" Visibility="Collapsed"/>

                <!-- Answer options -->
                <StackPanel x:Name="AnswersPanel"/>

                <!-- Feedback (study mode only) -->
                <Border x:Name="FeedbackBorder" Background="White" CornerRadius="6"
                        Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <TextBlock x:Name="FeedbackText"
                               FontSize="13" TextWrapping="Wrap"
                               FontWeight="SemiBold" LineHeight="20"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" Padding="24,12">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="-1" BlurRadius="8" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatsText"
                           FontSize="13" Foreground="#605E5C"
                           VerticalAlignment="Center"/>
                <Button x:Name="ActionButton" Grid.Column="1"
                        Content="Ответить"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="ActionButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
